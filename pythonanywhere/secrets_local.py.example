# -*- coding: utf-8 -*-
# ============================================================
# API Key 本地配置文件 —— 模板
# ============================================================
# 用途:PythonAnywhere 部分套餐没有 Web 面板的 "Environment variables",
#       这时用本文件代替环境变量给 app.py 提供 API_KEY。
#
# 用法:
#   1. 把本文件复制成 secrets_local.py(去掉 .example 后缀)
#      实际文件在 /home/nbchannel/nb-channel/pythonanywhere/secrets_local.py
#   2. 把下面的引号里换成真实 Key
#   3. 在 PythonAnywhere Web 面板点 Reload
#
# 为什么这样更安全:
#   · secrets_local.py 已写进 .gitignore,**不会进公开仓库**
#   · 它不在 git 跟踪范围内,改它不会和 git pull 冲突
#
# 优先级:环境变量 API_KEY 优先;环境变量没配时才读本文件。
#
# 轮换 Key:改这个值 → Reload。不用改任何代码。
# ============================================================

API_KEY = '在这里填你的真实 Key'


# ============================================================
#  Storage 用的 service_role key
# ============================================================
#  为什么需要它：
#      后端一直用【公开的 anon key】操作 Storage，而 anon key 就写在前端里，
#      谁都能拿到。Supabase 分不出「这是后端发的」还是「浏览器伪造的」——
#      所以只要后端能传能删，就等于任何人都能传能删。
#
#      后端换成 service_role 之后，这个前提就没了：
#          · 后端绕过 RLS，增删改查随便做
#          · anon 就可以一个写权限都不给
#
#  ⚠️⚠️ 这个 key 能绕过【所有】权限：
#          ❌ 不能写进任何 .html / .js
#          ❌ 不能提交进 git（本文件已在 .gitignore 里）
#          ❌ 不能发群、发截图
#          ✅ 只放在这个文件里
#
#  从哪拿：
#      Supabase 控制台 → Project Settings → API → Project API keys
#      → service_role 那一行（标着 secret）→ Reveal → 复制
#
#  填好之后：PythonAnywhere Web 面板点 Reload。
#  成功的话日志里会出现：
#      [NB] Storage 客户端已切换到 service_role（绕过 RLS）
#
#  只有看到那句话，才去跑
#      sql/URGENT_tighten_storage_after_service_role_20261005.sql
#  否则上传／换头像／删作品会全挂。
# ============================================================

SUPABASE_SERVICE_KEY = '在这里填你的 service_role key'
